# Local compose defaults work without this file. Copy to .env to configure email.
FRONTEND_PORT=8080
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
TRUST_PROXY=true
MONGO_URI=mongodb://mongo:27017/userdb

# Configure SMTP to enable email verification and password reset locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# For production, set NODE_ENV=production, APP_ORIGIN to your HTTPS URL and
# MONGO_URI to an authenticated, TLS-protected MongoDB service,
# Set TRUST_PROXY to the number of trusted proxy hops, and provide SMTP values.
